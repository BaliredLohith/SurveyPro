# Environment Variables for Vercel Deployment
# Copy this to .env.local for development or set in Vercel dashboard for production

# API Base URL - Replace with your deployed backend URL
REACT_APP_API_BASE_URL=https://your-backend-url.com/api

# For development (localhost)
# REACT_APP_API_BASE_URL=http://localhost:5000/api

# For production (Vercel)
# REACT_APP_API_BASE_URL=https://your-backend-deployment.com/api

# Optional: App environment
REACT_APP_ENV=production
