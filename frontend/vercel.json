{
  "version": 2,
  "name": "site-survey-tool-frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "env": {
    "REACT_APP_API_BASE_URL": "@api_base_url"
  },
  "build": {
    "env": {
      "REACT_APP_API_BASE_URL": "@api_base_url"
    }
  }
}
